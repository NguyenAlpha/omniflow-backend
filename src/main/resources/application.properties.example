# ─────────────────────────────────────────────────────────────────────────────
# FILE MẪU — copy thành application.properties (file đó bị .gitignore bỏ qua):
#   cp src/main/resources/application.properties.example src/main/resources/application.properties
# Rồi đặt 2 giá trị bắt buộc (qua biến môi trường hoặc sửa trực tiếp trong file copy):
#   JWT_SECRET          — openssl rand -base64 32   (thiếu → app dừng ngay lúc khởi động)
#   ADMIN_SEED_PASSWORD — mật khẩu SUPER_ADMIN được seed (thiếu khi admin.seed.enabled=true → dừng)
# Mọi biến môi trường khác: xem .env.example. Không commit secret thật vào file này.
# ─────────────────────────────────────────────────────────────────────────────

spring.application.name=quiktech-pos

# Database
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/quiktech-pos}
spring.datasource.username=${DB_USERNAME:quiktech-pos}
spring.datasource.password=${DB_PASSWORD:quiktech-pos123}
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

# Enable metrics endpoint
management.endpoints.web.exposure.include=health,prometheus
management.endpoint.metrics.access=read_only
management.endpoint.prometheus.access=read_only
management.health.mail.enabled=false
# Actuator (health, prometheus) chạy trên port quản trị riêng — chỉ mở trong mạng nội bộ
# cho Prometheus; port chính 8080 không còn /actuator/**
management.server.port=9090
# /livez và /readyz trên port chính cho health check của Docker/load balancer
management.endpoint.health.probes.enabled=true
management.endpoint.health.probes.add-additional-paths=true

# JWT
jwt.secret=${JWT_SECRET:}
# Access token sống ngắn (mặc định 1h = 3600000ms) — JWT stateless không thu hồi được,
# token bị lộ chỉ dùng được trong cửa sổ ngắn. Refresh token (30 ngày) lo gia hạn;
# web tự refresh khi gặp 401. Override qua env JWT_EXPIRATION nếu cần.
jwt.expiration=${JWT_EXPIRATION:3600000}
jwt.refresh-token-expiration-days=30

# Redis — override host/port/password qua env khi deploy Docker/cloud
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}

# Email (SMTP) — để trống để tắt tính năng gửi email
spring.mail.host=${MAIL_HOST:}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.from=${MAIL_FROM:noreply@quiktech.app}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# CORS — set CORS_ORIGINS = domain thật (phân tách bằng dấu phẩy) khi deploy
cors.allowed-origins=${CORS_ORIGINS:http://localhost:3000}

# Store role cache TTL (seconds)
store.role.cache.ttl=300

# Rate limiting
rate-limit.login.max-requests=10
rate-limit.login.window-seconds=60
# Đăng nhập sai theo tài khoản (LoginAttemptLimiter): số lần sai tối đa, nạp lại toàn bộ sau window
rate-limit.login-account.max-failures=5
rate-limit.login-account.window-seconds=900
rate-limit.register.max-requests=5
rate-limit.register.window-seconds=60
rate-limit.refresh.max-requests=20
rate-limit.refresh.window-seconds=60
# Coarse IP ceiling cho mọi /api/**. Giá trị rộng để nhiều máy trong cùng mạng
# cửa hàng không bị chặn nhầm; API đã xác thực còn có quota riêng theo user bên dưới.
rate-limit.api.ip.max-requests=1200
rate-limit.api.ip.window-seconds=60
# Quota mặc định cho từng user đã xác thực, áp dụng mọi API trừ route có quota riêng.
rate-limit.api.user.max-requests=300
rate-limit.api.user.window-seconds=60
# Các endpoint tốn tài nguyên hoặc nhạy cảm có quota riêng theo user.
rate-limit.import-products.user.max-requests=5
rate-limit.import-products.user.window-seconds=600
rate-limit.export.user.max-requests=10
rate-limit.export.user.window-seconds=600
rate-limit.inventory-bulk.user.max-requests=10
rate-limit.inventory-bulk.user.window-seconds=600
rate-limit.change-password.user.max-requests=5
rate-limit.change-password.user.window-seconds=600
# IP proxy tin cậy (comma-separated) — chỉ khi remoteAddr thuộc danh sách này thì
# X-Forwarded-For mới được dùng làm rate-limit key. Rỗng = luôn dùng remoteAddr.
# Deploy sau nginx/load balancer thì PHẢI set IP của proxy vào đây.
rate-limit.trusted-proxies=



# ── Seed dữ liệu mẫu ──────────────────────────────────────────────────────
# Công tắc TỔNG: một seed chỉ chạy khi SEED_ENABLED=true VÀ cờ [module].seed.enabled=true.
# Prod đặt SEED_ENABLED=false để tắt toàn bộ demo seed dù cờ con còn true.
# (Không áp cho admin.seed — đó là bootstrap super admin, có guard riêng.)
seed.enabled=${SEED_ENABLED:true}

# Unit seed
unit.seed.enabled=true

# User seed
user.seed.enabled=true

# Store seed
store.seed.enabled=true

# Category seed
category.seed.enabled=true

# Product seed
product.seed.enabled=true

# Warehouse seed
warehouse.seed.enabled=true

# Business seed
business.seed.enabled=true

# Supplier seed
supplier.seed.enabled=true

# Customer seed (historical demo data for Business One)
customer.seed.enabled=true

# Sales order seed (historical demo data for Business One)
order.seed.enabled=true

# Purchase order seed (historical demo data)
purchase-order.seed.enabled=true

# Subscription expiry scheduler — chạy lúc 01:00 AM mỗi ngày
subscription.expiry.cron=0 0 1 * * *

# Refresh token cleanup — xóa cứng token hết hạn quá retention-days, chạy 02:00 AM mỗi ngày
refresh-token.cleanup.cron=0 0 2 * * *
refresh-token.cleanup.retention-days=7

# System admin seed — mặc định false theo SECURITY.md mục 8: chỉ bật khi cần seed
# lần đầu, tắt ngay sau đó
admin.seed.enabled=true
admin.seed.username=admin
admin.seed.email=admin@admin.local
admin.seed.password=${ADMIN_SEED_PASSWORD:}
admin.seed.full-name=System Admin
admin.seed.role=ROLE_SUPER_ADMIN
#admin.seed.department=System
admin.seed.phone=
admin.seed.active=true
