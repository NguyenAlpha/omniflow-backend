# Database
DB_URL=jdbc:postgresql://localhost:5432/quiktech-pos
DB_USERNAME=quiktech-pos
DB_PASSWORD=quiktech-pos123

# JWT — generate: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=86400000

# Rate limiting — override the safe defaults only after observing production traffic.
# Keep RATE_LIMIT_TRUSTED_PROXIES empty unless the backend is reached through a
# known reverse proxy/load balancer; use its direct remote IP(s), comma-separated.
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_REFRESH_MAX_REQUESTS=20
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_API_IP_MAX_REQUESTS=1200
RATE_LIMIT_API_IP_WINDOW_SECONDS=60
RATE_LIMIT_API_USER_MAX_REQUESTS=300
RATE_LIMIT_API_USER_WINDOW_SECONDS=60
RATE_LIMIT_IMPORT_PRODUCTS_USER_MAX_REQUESTS=5
RATE_LIMIT_IMPORT_PRODUCTS_USER_WINDOW_SECONDS=600
RATE_LIMIT_EXPORT_USER_MAX_REQUESTS=10
RATE_LIMIT_EXPORT_USER_WINDOW_SECONDS=600
RATE_LIMIT_CHANGE_PASSWORD_USER_MAX_REQUESTS=5
RATE_LIMIT_CHANGE_PASSWORD_USER_WINDOW_SECONDS=600
RATE_LIMIT_TRUSTED_PROXIES=
RATE_LIMIT_REDIS_TIMEOUT_MILLIS=200
RATE_LIMIT_REDIS_COOLDOWN_MILLIS=5000
# Increment on every quota change, including rollback. All instances in a release must agree.
RATE_LIMIT_CONFIG_VERSION=1

# System admin seed (admin.seed.enabled=true must be set to activate)
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@admin.local
ADMIN_SEED_PASSWORD=
